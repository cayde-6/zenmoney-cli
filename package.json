{
  "name": "@cayde-6/zenmoney-cli",
  "version": "0.1.1",
  "description": "ZenMoney CLI: read-only analysis, plus dry-run-first writes (zm edit/add/delete)",
  "type": "module",
  "bin": {
    "zm": "dist/bin.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm run build && npm run test:coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "zenmoney",
    "cli",
    "budget",
    "finance",
    "agent",
    "personal-finance",
    "ai-agent",
    "llm",
    "sqlite"
  ],
  "author": {
    "name": "cayde-6",
    "url": "https://github.com/cayde-6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cayde-6/zenmoney-cli.git"
  },
  "homepage": "https://github.com/cayde-6/zenmoney-cli#readme",
  "bugs": {
    "url": "https://github.com/cayde-6/zenmoney-cli/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
